# Sao chép thành .env khi chạy trên máy. Trên Hostinger, nhập các biến này ở hPanel > Node.js > Environment variables.
NODE_ENV=production
PORT=3000
SITE_URL=https://shophoathanhnha.com

# Mật khẩu admin: dùng một trong hai (khuyên dùng HASH, tạo bằng: npm run hash-password -- "mat khau")
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập (vd: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Thư mục lưu dữ liệu (đơn hàng, sản phẩm, ảnh tải lên). Trên Hostinger nên đặt NGOÀI thư mục mã nguồn,
# vd: /home/uXXXXXXXX/shop-data để không mất dữ liệu khi deploy lại.
DATA_DIR=

# Tài khoản nhận chuyển khoản VietQR (có thể nhập trong Admin > Cài đặt thay vì ở đây)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT=
VIETQR_ACCOUNT_NAME=
VIETQR_BANK_NAME=

# Báo đơn mới qua Telegram (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Báo đơn mới qua email (tùy chọn) – email Hostinger: smtp.hostinger.com, cổng 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
