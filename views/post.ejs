<%- include('partials/header', { preload: post.image }) %>
<article class="container article">
  <% if (post.tags && post.tags.length) { %><span class="eyebrow"><%= post.tags[0] %></span><% } %>
  <h1 style="font-size:clamp(2.2rem,4.6vw,3.4rem)"><%= post.title %></h1>
  <p class="muted"><time datetime="<%= post.publishedAt %>"><%= formatDate(post.publishedAt) %></time> · Đội ngũ florist <%= site.name %></p>
  <img class="article-cover" src="<%= post.image %>" alt="<%= post.title %>" width="1200" height="750" fetchpriority="high">
  <div class="prose"><%- html %></div>
  <div class="cta-band" style="margin-top:48px">
    <div><h2 style="font-size:1.9rem">Đặt hoa tươi giao trong ngày</h2><p>Florist tư vấn miễn phí, giao nhanh 1–3 giờ nội thành.</p></div>
    <div class="actions"><a class="btn btn-primary" href="/danh-muc/bo-hoa-tuoi">Xem mẫu hoa</a><a class="btn btn-light" href="tel:<%= site.phone %>"><%= site.phoneDisplay %></a></div>
  </div>
</article>
<section class="section section-alt">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow">Gợi ý cho bạn</span><h2>Mẫu hoa được yêu thích</h2></div></div>
    <div class="product-grid"><% suggestions.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </div>
</section>
<% if (more.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><div><h2>Bài viết khác</h2></div></div>
    <div class="post-grid">
      <% more.forEach((m) => { %>
      <article class="post-card"><a href="/blog/<%= m.slug %>"><img src="<%= m.image %>" alt="<%= m.title %>" width="1200" height="750" loading="lazy"></a><time datetime="<%= m.publishedAt %>"><%= formatDate(m.publishedAt) %></time><h3><a href="/blog/<%= m.slug %>"><%= m.title %></a></h3></article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
