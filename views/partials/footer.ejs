</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/"><img src="/images/logo.svg" alt="" width="44" height="44" loading="lazy"><span class="logo-text"><strong>Thanh Nhã</strong><span>Shop hoa tươi</span></span></a>
        <p style="margin-top:18px;max-width:340px"><%= site.legalName %> – <%= site.tagline %>. Hoa cắm mới mỗi sáng, giao nhanh tận tay người nhận.</p>
        <div class="socials">
          <% for (const s of site.socials) { %>
          <a href="<%= s.href %>" target="_blank" rel="noopener" aria-label="<%= s.name %>"><svg class="icon"><use href="#i-<%= s.name.toLowerCase() %>"/></svg></a>
          <% } %>
        </div>
      </div>
      <div>
        <h3>Danh mục</h3>
        <ul>
          <% for (const c of navCategories) { %><li><a href="/danh-muc/<%= c.slug %>"><%= c.name %></a></li><% } %>
        </ul>
      </div>
      <div>
        <h3>Hỗ trợ</h3>
        <ul>
          <li><a href="/tra-cuu-don-hang">Tra cứu đơn hàng</a></li>
          <li><a href="/chinh-sach/giao-hang">Chính sách giao hàng</a></li>
          <li><a href="/chinh-sach/doi-tra">Đổi trả &amp; hoàn tiền</a></li>
          <li><a href="/chinh-sach/thanh-toan">Hướng dẫn thanh toán</a></li>
          <li><a href="/chinh-sach/bao-mat">Chính sách bảo mật</a></li>
          <li><a href="/cau-hoi-thuong-gap">Câu hỏi thường gặp</a></li>
          <li><a href="/gioi-thieu">Giới thiệu</a></li>
          <li><a href="/blog">Cẩm nang hoa</a></li>
        </ul>
      </div>
      <div>
        <h3>Liên hệ</h3>
        <ul>
          <li>Hotline &amp; Zalo: <a href="tel:<%= site.phone %>"><strong style="color:#fff"><%= site.phoneDisplay %></strong></a></li>
          <li>Email: <a href="mailto:<%= site.email %>"><%= site.email %></a></li>
          <li>Mở cửa: <%= site.hours %> mỗi ngày</li>
          <li><%= site.mainStore.street %>, <%= site.mainStore.district %>, <%= site.mainStore.city %></li>
          <li><a class="link" style="color:#f3d9a4" href="/he-thong-cua-hang">Xem <%= site.stores.reduce((n, s) => n + s.addresses.length, 0) %> cửa hàng <svg class="icon"><use href="#i-arrow"/></svg></a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= site.name %>. Ảnh minh họa từ Unsplash.</span>
      <span><a href="/sitemap.xml">Sơ đồ trang</a></span>
    </div>
  </div>
</footer>
<div class="float-contact">
  <a class="zalo" href="<%= site.zalo %>" target="_blank" rel="noopener" aria-label="Nhắn Zalo">Zalo</a>
  <a class="call" href="tel:<%= site.phone %>" aria-label="Gọi <%= site.phoneDisplay %>"><svg class="icon"><use href="#i-phone"/></svg></a>
</div>
<div class="toast" role="status" aria-live="polite" data-toast></div>
<script src="/js/app.js?v=<%= v %>" defer></script>
</body>
</html>
