<% const val = values[name] || ''; const err = errors[name]; %>
<div class="field <%= err ? 'has-error' : '' %> <%= typeof full !== 'undefined' && full ? 'full' : '' %>">
  <label for="f-<%= name %>"><%= label %><% if (typeof required !== 'undefined' && required) { %> <span class="req" aria-hidden="true">*</span><% } %></label>
  <% if (typeof type !== 'undefined' && type === 'textarea') { %>
  <textarea class="textarea" id="f-<%= name %>" name="<%= name %>" <%= typeof maxlength !== 'undefined' ? `maxlength=${maxlength}` : '' %> <% if (err) { %>aria-invalid="true" aria-describedby="e-<%= name %>"<% } %> placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '' %>"><%= val %></textarea>
  <% } else { %>
  <input class="input" id="f-<%= name %>" name="<%= name %>" type="<%= typeof type !== 'undefined' ? type : 'text' %>" value="<%= val %>" <% if (typeof required !== 'undefined' && required) { %>required<% } %> <% if (typeof autocomplete !== 'undefined') { %>autocomplete="<%= autocomplete %>"<% } %> <% if (typeof min !== 'undefined') { %>min="<%= min %>"<% } %> <% if (typeof inputmode !== 'undefined') { %>inputmode="<%= inputmode %>"<% } %> <% if (err) { %>aria-invalid="true" aria-describedby="e-<%= name %>"<% } %> placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '' %>">
  <% } %>
  <% if (err) { %><div class="field-error" id="e-<%= name %>"><%= err %></div><% } else if (typeof hint !== 'undefined') { %><div class="hint"><%= hint %></div><% } %>
</div>
