<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Đăng nhập quản trị · <%= site.name %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@600;700&family=Montserrat:wght@400;500;600;700&display=swap&subset=vietnamese">
  <link rel="stylesheet" href="/css/style.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
  <div class="login-box">
    <a class="logo" href="/" style="justify-content:center;margin-bottom:24px"><img src="/images/logo.svg" alt="" width="48" height="48"><span class="logo-text"><strong>Thanh Nhã</strong><span>Quản trị</span></span></a>
    <form class="panel" method="post" style="display:grid;gap:16px">
      <% if (!configured) { %><div class="alert alert-error">Chưa đặt biến môi trường <code>ADMIN_PASSWORD</code> hoặc <code>ADMIN_PASSWORD_HASH</code>. Xem README.</div><% } %>
      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label for="pw">Mật khẩu</label><input class="input" id="pw" type="password" name="password" autocomplete="current-password" required autofocus></div>
      <button class="btn btn-primary" type="submit">Đăng nhập</button>
    </form>
  </div>
</body>
</html>
