<div class="table-wrap">
  <table class="t">
    <thead><tr><th>Mã đơn</th><th>Người gửi</th><th>Giao</th><th>Tổng</th><th>Thanh toán</th><th>Trạng thái</th></tr></thead>
    <tbody>
      <% if (!list.length) { %><tr><td colspan="6" class="muted">Chưa có đơn hàng.</td></tr><% } %>
      <% list.forEach((o) => { %>
      <tr>
        <td><a href="/admin/don-hang/<%= o.id %>"><%= o.code %></a><br><small class="muted"><%= formatDate(o.createdAt) %></small></td>
        <td><%= o.sender.name %><br><small class="muted"><%= o.sender.phone %></small></td>
        <td><%= o.delivery.date.split('-').reverse().join('/') %><br><small class="muted"><%= o.delivery.slot %></small></td>
        <td><b><%= formatVND(o.total) %></b></td>
        <td><%= o.paymentMethod === 'bank' ? 'Chuyển khoản' : 'COD' %><br><span class="status-pill <%= o.paymentStatus %>"><%= PAYMENT_STATUS[o.paymentStatus] %></span></td>
        <td><span class="status-pill <%= o.status %>"><%= STATUS[o.status] %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
