<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Quản trị · <%= site.name %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@600;700&family=Montserrat:wght@400;500;600;700&display=swap&subset=vietnamese">
  <link rel="stylesheet" href="/css/style.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
<% const nav = [['/admin', 'Tổng quan'], ['/admin/don-hang', 'Đơn hàng', newOrders], ['/admin/san-pham', 'Sản phẩm'], ['/admin/bai-viet', 'Bài viết'], ['/admin/lien-he', 'Liên hệ', unread], ['/admin/cai-dat', 'Cài đặt']]; %>
<div class="admin">
  <aside class="admin-side">
    <a class="logo" href="/admin"><img src="/images/logo.svg" alt="" width="38" height="38"><span class="logo-text"><strong>Thanh Nhã</strong></span></a>
    <nav aria-label="Quản trị">
      <% nav.forEach(([href, label, n]) => { const active = href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href); %>
      <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %><% if (n) { %><span class="count"><%= n %></span><% } %></a>
      <% }) %>
      <a href="/" target="_blank" rel="noopener">Xem website ↗</a>
      <form method="post" action="/admin/dang-xuat"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Đăng xuất</button></form>
    </nav>
  </aside>
  <main class="admin-main">
